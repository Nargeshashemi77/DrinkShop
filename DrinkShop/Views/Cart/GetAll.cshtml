@model List<CartResultViewModel>
@{
    ViewData["Title"] = "لیست سفارشات";
}
@{
    var totalCart = Model.Sum(x => x.TotalPrice);
}
<style>
    .checkout-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
    }
</style>
<!--section start-->
<section class="cart-section section-b-space cmn_bg_yellow">

    <ul class="plus_decore">
        <li></li>
        <li></li>
    </ul>

    <div class="container">
        <div class="row">
            <div class="col-sm-12">
                @if (Model.Count != 0)
                {
                    <table class="table cart-table table-responsive-sm">
                        <thead>
                            <tr class="table-head">
                                <th scope="col">شناسه</th>
                                <th scope="col">شناسه محصول</th>
                                <th scope="col">تصویر </th>
                                <th scope="col">نام </th>
                                <th scope="col">تعداد</th>
                                <th scope="col">قیمت </th>
                                <th scope="col">قیمت نهایی</th>
                                <th scope="col">حذف</th>
                                <th scope="col">ویرایش</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.CartId</td>
                                    <td>@item.ProductId</td>
                                    <td>
                                        <a href="/Product/ProductDetails?productId=@(item.ProductId)">
                                            <img src="~/assets/images/product-image/@(item.ProductImage)" alt="ProductImage">
                                        </a>
                                    </td>
                                    <td>
                                        <span href="#">@item.ProductName</span>
                                    </td>
                                    <td>
                                        <div class="qty-box">
                                            <input type="number" id="cartId_@item.CartId" class="form-control input-number" value="@item.Quantity"><div class="input-group">
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <h4>
                                            <span>
                                                @(((ulong)item.UnitPrice).ToMoreReadable())
                                            </span>تومان
                                        </h4>
                                    </td>
                                    <td>
                                        <h4>
                                            <span>
                                                @(((ulong)item.TotalPrice).ToMoreReadable())
                                            </span>تومان
                                        </h4>
                                    </td>
                                    <td>
                                        <button onclick="deleteCartItem(@item.CartId)" style="padding:8px 19px" class="theme_btn">
                                            <i class="fa fa-times" aria-hidden="true"></i>
                                        </button>

                                    </td>
                                    <td>
                                        <button onclick="editCart(@item.CartId)" style="padding:8px 19px" class="theme_btn">
                                            ویرایش
                                            <span class="theme_btn_eff"></span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="checkout-wrapper">
                        <h4>
                            جمع کل:
                            @(((ulong)totalCart).ToMoreReadable()) تومان
                        </h4>
                    </div>

                    <div class="checkout-wrapper">
                        <a href="/carts/checkout" class="theme_btn">
                            ادامه خرید
                        </a>
                    </div>
                }
                else
                {
                    <h6 style="text-align:center;">آیتمی وجود ندارد</h6>
                }
            </div>
        </div>
    </div>
</section>
<script src="~/assets/js/UserCarts.js?version=1"></script>
