@model List<UserOrderViewModel>
@{
    ViewData["Title"] = "لیست سفارشات";
}
<!--section start-->
<section class="cart-section section-b-space cmn_bg_yellow">

    <ul class="plus_decore">
        <li></li>
        <li></li>
    </ul>

    <div class="container">
        <div class="row">
            <div class="col-sm-12">
                @if (Model.Count != 0)
                {
                    <table class="table cart-table table-responsive-sm">
                        <thead>
                            <tr class="table-head">
                                <th>شناسه سفارش</th>
                                <th scope="col">وضعیت</th>
                                <th scope="col">مبلغ</th>
                                <th scope="col">تاریخ</th>
                                <th scope="col">زمان</th>
                                <th scope="col">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.StatusDescription</td>
                                    <td>
                                        <h4>
                                            <span>@(((ulong)item.TotalPrice).ToMoreReadable())</span>
                                            تومان
                                        </h4>
                                    </td>
                                    <td>@item.createdAt.ToShamsi()</td>
                                    <td>@item.createdAt.ToString("HH:mm:ss")</td>
                                    <td>
                                        <button style="padding:8px 19px" class="theme_btn">
                                            جزییات
                                            <span class="theme_btn_eff"></span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <h6 style="text-align:center;">سفارشی وجود ندارد</h6>
                }
            </div>
        </div>
    </div>
</section>
<script src="~/assets/js/UserOrders.js?version=5"></script>
